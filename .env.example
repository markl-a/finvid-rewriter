# 複製成 .env 並填入你自己的 key（不要把 .env 推上 GitHub）
# 請在等號後面填入你的 OpenAI key（sk-...）；留空或填非 ASCII 字串會在跑任何步驟前被擋下
OPENAI_API_KEY=

# ---- 以下皆為選填，有預設值 ----
# STT：openai（預設）或 local（faster-whisper，零成本、需 pip install -e ".[local-stt]"）
FINVID_STT_PROVIDER=openai
FINVID_STT_MODEL=gpt-4o-mini-transcribe
FINVID_LOCAL_WHISPER_MODEL=small

# LLM：Pass A（便宜、切段打分）與 Pass B（較強、只對選中的段落寫腳本）
FINVID_LLM_CHEAP_MODEL=gpt-5-mini
FINVID_LLM_STRONG_MODEL=gpt-5

# TTS：edge（免費，預設）或 openai
FINVID_TTS_PROVIDER=edge
FINVID_TTS_VOICE=zh-TW-HsiaoChenNeural

# 第 4 步 AI 生成畫面：none（預設，靜態卡 $0、秒級）
#   hf     Hugging Face ZeroGPU 上的 Lightricks LTX-Video Space：免費、不用 key、每段約 25 秒；匿名一天約 1–2 段，
#          填 HF_TOKEN（免費帳號）額度較大
#   comfy  本機 ComfyUI + LTX-Video：$0、每段約 80–120 秒 GPU
#   pixazo Pixazo 代管的 LTX-Video（免費預覽方案、不用信用卡）：$0、每段約 60 秒，需要免費 key
#   minimax MiniMax Hailuo（唯一付費選項）：768P 每段 $0.27、約 20–60 秒，受 FINVID_MAX_BUDGET_USD 護欄
#   可用逗號串成備援鏈，例如 hf,pixazo,comfy = 先用免費雲端額度，用完自動改本機；付費的放最後才會被用到
FINVID_AI_VIDEO=none
# HF_TOKEN=hf_...（選填：huggingface.co → Settings → Access Tokens → Read）
# PIXAZO_API_KEY=（免費：https://www.pixazo.ai 註冊即有 LTX 免費方案的 key，不用信用卡）
# MINIMAX_API_KEY=（付費：https://platform.minimax.io，Hailuo 影片每段 $0.08–0.54，見 docs/COST.md）
# FINVID_MINIMAX_MODEL=MiniMax-Hailuo-02
# FINVID_MINIMAX_RESOLUTION=768P
# FINVID_HF_SPACE=Lightricks/ltx-video-distilled
# FINVID_COMFY_URL=http://127.0.0.1:8188
# FINVID_COMFY_CHECKPOINT=ltxv-2b-0.9.8-distilled.safetensors
# FINVID_COMFY_TEXT_ENCODER=t5xxl_fp8_e4m3fn_scaled.safetensors
# FINVID_AI_SHOT_SECONDS=5
# FINVID_AI_SHOTS_PER_CLIP=2

# 成本護欄
FINVID_MAX_BUDGET_USD=1.00
FINVID_MAX_CLIPS=3
FINVID_HOOK_THRESHOLD=3

# 音檔前處理
FINVID_REMOVE_SILENCE=true
FINVID_TRIM_HEAD_SEC=0
FINVID_TRIM_TAIL_SEC=0
FINVID_SPEEDUP=1.0

# ffmpeg 路徑（PATH 找得到就不用填）
# FINVID_FFMPEG=C:\path\to\ffmpeg.exe

# 字幕／圖表用的繁中字型（Windows 微軟正黑體、macOS PingFang 會自動找到；Linux 請裝 fonts-noto-cjk 或指定路徑）
# FINVID_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
