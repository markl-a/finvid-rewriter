# 複製成 .env 並填入你自己的 key（不要把 .env 推上 GitHub）
OPENAI_API_KEY=請在此填入你的 key

# ---- 以下皆為選填，有預設值 ----
# STT：openai（預設）或 local（faster-whisper，零成本、需 pip install -e ".[local-stt]"）
FINVID_STT_PROVIDER=openai
FINVID_STT_MODEL=gpt-4o-mini-transcribe
FINVID_LOCAL_WHISPER_MODEL=small

# LLM：Pass A（便宜、切段打分）與 Pass B（較強、只對選中的段落寫腳本）
FINVID_LLM_CHEAP_MODEL=gpt-5-mini
FINVID_LLM_STRONG_MODEL=gpt-5

# TTS：edge（免費，預設）或 openai
FINVID_TTS_PROVIDER=edge
FINVID_TTS_VOICE=zh-TW-HsiaoChenNeural

# 成本護欄
FINVID_MAX_BUDGET_USD=1.00
FINVID_MAX_CLIPS=3
FINVID_HOOK_THRESHOLD=3

# 音檔前處理
FINVID_REMOVE_SILENCE=true
FINVID_TRIM_HEAD_SEC=0
FINVID_TRIM_TAIL_SEC=0
FINVID_SPEEDUP=1.0

# ffmpeg 路徑（PATH 找得到就不用填）
# FINVID_FFMPEG=C:\path\to\ffmpeg.exe
